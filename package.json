{
  "name": "edith",
  "private": true,
  "version": "3.7.3",
  "description": "Edith — a local Mac Markdown editor. Run `npm install` then `npm run build`.",
  "scripts": {
    "bundle": "esbuild entry.js --bundle --minify --format=iife --outfile=vendor.min.js",
    "build": "npm run bundle && python3 build.py && cp dist.html electron-app/index.html",
    "package": "npm run build && electron-packager electron-app Edith --platform=darwin --arch=arm64 --electron-version=44.7.2 --out=build --overwrite --icon=brand/edith.icns --app-bundle-id=app.edith.mac --app-version=3.7.3 --extend-info=extend.plist",
    "dev": "npm run build && electron electron-app",
    "test": "node tests/run.mjs",
    "test:electron": "node tests/run.mjs electron",
    "format": "prettier --write app.js electron-app/main.js && black build.py"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@fontsource/nunito-sans": "5.3.0",
    "@fontsource/share-tech-mono": "5.3.0",
    "@fontsource/source-sans-3": "5.3.1",
    "@fontsource/work-sans": "5.3.0",
    "@toast-ui/editor": "3.2.2",
    "diff": "5.2.2",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.3.289",
    "turndown": "7.2.0",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.7.2",
    "esbuild": "0.24.0",
    "playwright": "1.56.0",
    "prettier": "3.9.9"
  }
}
